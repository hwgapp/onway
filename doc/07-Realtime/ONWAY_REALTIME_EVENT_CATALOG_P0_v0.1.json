{
  "version": "0.1",
  "status": "draft",
  "updatedAt": "2026-09-11",
  "transport": {
    "sourceOfTruth": "GraphQL/PostgreSQL",
    "realtimeGateway": "WebSocket",
    "auth": "Firebase ID token",
    "emitRule": "Emit only after database transaction commit",
    "resyncRule": "Client must refetch GraphQL state after reconnect gap, permission change, stale sequence or room.resync_required"
  },
  "envelope": {
    "eventId": "uuid",
    "type": "string",
    "room": "string",
    "sequence": "integer per room",
    "occurredAt": "ISO-8601 datetime",
    "entity": {
      "type": "string",
      "id": "uuid",
      "version": "integer"
    },
    "payload": "event specific object"
  },
  "rooms": [
    {
      "pattern": "account:{accountId}",
      "members": ["own account sessions"],
      "purpose": "Account status and global notifications"
    },
    {
      "pattern": "customer:{customerProfileId}",
      "members": ["customer sessions"],
      "purpose": "Customer Ride/Food updates"
    },
    {
      "pattern": "driver:{driverProfileId}",
      "members": ["driver sessions"],
      "purpose": "Offers, driver status and assigned job updates"
    },
    {
      "pattern": "ride:{rideId}",
      "members": ["ride customer", "assigned driver", "authorized admin"],
      "purpose": "Ride lifecycle, payment and tracking"
    },
    {
      "pattern": "food_order:{foodOrderId}",
      "members": ["food customer", "assigned driver", "authorized admin"],
      "purpose": "Food order lifecycle, payment and tracking"
    },
    {
      "pattern": "chat:{chatRoomId}",
      "members": ["chat participants", "authorized admin viewer"],
      "purpose": "Chat text/image messages"
    },
    {
      "pattern": "admin:operations",
      "members": ["authorized admins"],
      "purpose": "Operational monitoring"
    },
    {
      "pattern": "admin:complaints",
      "members": ["authorized support admins"],
      "purpose": "Complaint/dispute monitoring"
    }
  ],
  "clientCommands": [
    {
      "type": "connection.init",
      "direction": "client_to_server",
      "authRequired": false,
      "payloadFields": {
        "token": "Firebase ID token",
        "client.app": "customer|driver|admin",
        "client.platform": "ios|android|web",
        "client.appVersion": "string",
        "client.deviceId": "opaque string"
      }
    },
    {
      "type": "connection.resume",
      "direction": "client_to_server",
      "authRequired": true,
      "payloadFields": {
        "lastSeen": "array of { room, sequence }"
      }
    },
    {
      "type": "room.subscribe",
      "direction": "client_to_server",
      "authRequired": true,
      "payloadFields": {
        "room": "room id",
        "lastSeenSequence": "integer optional"
      }
    },
    {
      "type": "room.unsubscribe",
      "direction": "client_to_server",
      "authRequired": true,
      "payloadFields": {
        "room": "room id"
      }
    },
    {
      "type": "driver.location_update",
      "direction": "client_to_server",
      "authRequired": true,
      "actor": "driver",
      "rateLimit": "max 1 per second on active job, configurable",
      "payloadFields": {
        "location": "GeoPoint",
        "accuracyMeters": "number",
        "heading": "number optional",
        "speedMps": "number optional",
        "capturedAt": "ISO-8601 datetime",
        "activeEntityType": "ride|food_order|null",
        "activeEntityId": "uuid optional"
      }
    },
    {
      "type": "chat.typing",
      "direction": "client_to_server",
      "authRequired": true,
      "actor": "chat participant",
      "requiredForP0": false,
      "payloadFields": {
        "room": "chat:{chatRoomId}",
        "isTyping": "boolean"
      }
    }
  ],
  "serverEvents": [
    {
      "type": "connection.ack",
      "rooms": ["connection"],
      "entityType": "connection",
      "payloadFields": {
        "connectionId": "uuid",
        "accountId": "uuid",
        "roles": "ActorRole[]",
        "serverTime": "ISO-8601 datetime",
        "heartbeatIntervalMs": "integer"
      }
    },
    {
      "type": "connection.error",
      "rooms": ["connection"],
      "entityType": "connection",
      "payloadFields": {
        "code": "UNAUTHENTICATED|FORBIDDEN|RATE_LIMITED|INVALID_MESSAGE|SERVER_ERROR",
        "message": "string"
      }
    },
    {
      "type": "room.subscribed",
      "rooms": ["connection"],
      "entityType": "room",
      "payloadFields": {
        "room": "room id",
        "resyncRequired": "boolean",
        "currentSequence": "integer"
      }
    },
    {
      "type": "room.resync_required",
      "rooms": ["subscribed room"],
      "entityType": "room",
      "payloadFields": {
        "room": "room id",
        "reason": "sequence_gap|buffer_expired|permission_changed"
      }
    },
    {
      "type": "driver.location_ack",
      "rooms": ["connection"],
      "entityType": "driver_presence",
      "payloadFields": {
        "clientEventId": "uuid",
        "accepted": "boolean",
        "reason": "string|null",
        "serverTime": "ISO-8601 datetime"
      }
    },
    {
      "type": "presence.driver_online",
      "rooms": ["driver:{driverProfileId}", "admin:operations"],
      "entityType": "driver_presence",
      "payloadFields": {
        "driverProfileId": "uuid",
        "vehicleId": "uuid",
        "serviceTypes": "ServiceType[]",
        "regionId": "uuid",
        "location": "GeoPoint",
        "available": "boolean"
      }
    },
    {
      "type": "presence.driver_offline",
      "rooms": ["driver:{driverProfileId}", "admin:operations"],
      "entityType": "driver_presence",
      "payloadFields": {
        "driverProfileId": "uuid",
        "reason": "manual|forced|stale|locked|region_paused"
      }
    },
    {
      "type": "presence.driver_location_changed",
      "rooms": ["ride:{rideId}", "food_order:{foodOrderId}", "admin:operations"],
      "entityType": "driver_location",
      "payloadFields": {
        "driverProfileId": "uuid",
        "location": "GeoPoint",
        "accuracyMeters": "number",
        "heading": "number optional",
        "capturedAt": "ISO-8601 datetime"
      }
    },
    {
      "type": "matching.offer_sent",
      "rooms": ["driver:{driverProfileId}"],
      "entityType": "matching_offer",
      "payloadFields": {
        "offerId": "uuid",
        "matchingSessionId": "uuid",
        "serviceType": "RIDE|FOOD",
        "entityId": "uuid",
        "batchNumber": "integer",
        "offeredPrice": "Money",
        "expiresAt": "ISO-8601 datetime",
        "summary": "OfferSummary"
      }
    },
    {
      "type": "matching.offer_expired",
      "rooms": ["driver:{driverProfileId}"],
      "entityType": "matching_offer",
      "payloadFields": {
        "offerId": "uuid",
        "matchingSessionId": "uuid",
        "reason": "timeout|assignment_taken|customer_cancelled|driver_ineligible"
      }
    },
    {
      "type": "matching.assigned",
      "rooms": ["customer:{customerProfileId}", "driver:{driverProfileId}", "ride:{rideId}", "food_order:{foodOrderId}", "admin:operations"],
      "entityType": "matching_session",
      "payloadFields": {
        "serviceType": "RIDE|FOOD",
        "entityId": "uuid",
        "driverProfileId": "uuid",
        "customerProfileId": "uuid",
        "chatRoomId": "uuid",
        "nextState": "string"
      }
    },
    {
      "type": "matching.no_driver_available",
      "rooms": ["customer:{customerProfileId}", "admin:operations"],
      "entityType": "matching_session",
      "payloadFields": {
        "serviceType": "RIDE|FOOD",
        "entityId": "uuid",
        "reason": "max_attempts_reached|no_candidate|region_paused"
      }
    },
    {
      "type": "ride.status_changed",
      "rooms": ["ride:{rideId}", "admin:operations"],
      "entityType": "ride",
      "payloadFields": {
        "rideId": "uuid",
        "fromStatus": "RideStatus",
        "toStatus": "RideStatus",
        "changedBy.actorType": "CUSTOMER|DRIVER|ADMIN|SYSTEM",
        "changedBy.actorId": "uuid|null",
        "allowedActionsChanged": "boolean",
        "timestamp": "ISO-8601 datetime"
      }
    },
    {
      "type": "ride.payment_required",
      "rooms": ["ride:{rideId}"],
      "entityType": "direct_payment_record",
      "payloadFields": {
        "rideId": "uuid",
        "paymentRecordId": "uuid",
        "requiredBeforeEvent": "ride_start|ride_completion",
        "amount": "Money"
      }
    },
    {
      "type": "ride.cancelled",
      "rooms": ["ride:{rideId}", "admin:operations"],
      "entityType": "ride",
      "payloadFields": {
        "rideId": "uuid",
        "cancelledBy": "CUSTOMER|DRIVER|ADMIN|SYSTEM",
        "reason": "string",
        "paymentProofExists": "boolean"
      }
    },
    {
      "type": "food_order.status_changed",
      "rooms": ["food_order:{foodOrderId}", "admin:operations"],
      "entityType": "food_order",
      "payloadFields": {
        "foodOrderId": "uuid",
        "fromStatus": "FoodOrderStatus",
        "toStatus": "FoodOrderStatus",
        "changedBy.actorType": "CUSTOMER|DRIVER|ADMIN|SYSTEM",
        "changedBy.actorId": "uuid|null",
        "allowedActionsChanged": "boolean",
        "timestamp": "ISO-8601 datetime"
      }
    },
    {
      "type": "food_order.payment_required",
      "rooms": ["food_order:{foodOrderId}"],
      "entityType": "direct_payment_record",
      "payloadFields": {
        "foodOrderId": "uuid",
        "paymentRecordId": "uuid",
        "amount": "Money",
        "requiredBeforeEvent": "food_driver_purchase",
        "instructionsAvailable": "boolean"
      }
    },
    {
      "type": "food_order.change_requested",
      "rooms": ["food_order:{foodOrderId}"],
      "entityType": "food_change_request",
      "payloadFields": {
        "foodOrderId": "uuid",
        "changeRequestId": "uuid",
        "reasonType": "FoodChangeReasonType",
        "requiresCustomerDecision": "boolean",
        "expiresAt": "ISO-8601 datetime"
      }
    },
    {
      "type": "food_order.change_decided",
      "rooms": ["food_order:{foodOrderId}", "admin:operations"],
      "entityType": "food_change_request",
      "payloadFields": {
        "foodOrderId": "uuid",
        "changeRequestId": "uuid",
        "decision": "ACCEPTED|REJECTED",
        "decidedBy": "CUSTOMER|SYSTEM|ADMIN",
        "newEstimatedTotal": "Money|null"
      }
    },
    {
      "type": "payment.proof_submitted",
      "rooms": ["ride:{rideId}", "food_order:{foodOrderId}", "driver:{driverProfileId}"],
      "entityType": "direct_payment_record",
      "payloadFields": {
        "paymentRecordId": "uuid",
        "serviceType": "RIDE|FOOD",
        "entityId": "uuid",
        "proofId": "uuid",
        "submittedByAccountId": "uuid",
        "submittedAt": "ISO-8601 datetime"
      }
    },
    {
      "type": "payment.driver_confirmed",
      "rooms": ["ride:{rideId}", "food_order:{foodOrderId}", "customer:{customerProfileId}", "admin:operations"],
      "entityType": "direct_payment_record",
      "payloadFields": {
        "paymentRecordId": "uuid",
        "serviceType": "RIDE|FOOD",
        "entityId": "uuid",
        "status": "DRIVER_CONFIRMED_RECEIVED",
        "confirmedAt": "ISO-8601 datetime"
      }
    },
    {
      "type": "payment.driver_reported_not_received",
      "rooms": ["ride:{rideId}", "food_order:{foodOrderId}", "customer:{customerProfileId}", "admin:operations", "admin:complaints"],
      "entityType": "direct_payment_record",
      "payloadFields": {
        "paymentRecordId": "uuid",
        "serviceType": "RIDE|FOOD",
        "entityId": "uuid",
        "status": "DRIVER_REPORTED_NOT_RECEIVED",
        "adminReviewRequired": "boolean"
      }
    },
    {
      "type": "chat.message_created",
      "rooms": ["chat:{chatRoomId}"],
      "entityType": "chat_message",
      "payloadFields": {
        "messageId": "uuid",
        "roomId": "uuid",
        "clientMessageId": "string",
        "senderAccountId": "uuid",
        "senderRole": "CUSTOMER|DRIVER|ADMIN",
        "messageType": "TEXT|IMAGE",
        "bodyText": "string|null",
        "attachments": "array of media summary",
        "sentAt": "ISO-8601 datetime"
      }
    },
    {
      "type": "chat.message_delivery_updated",
      "rooms": ["chat:{chatRoomId}"],
      "entityType": "chat_message",
      "requiredForP0": false,
      "payloadFields": {
        "messageId": "uuid",
        "status": "DELIVERED|READ"
      }
    },
    {
      "type": "chat.room_closed",
      "rooms": ["chat:{chatRoomId}"],
      "entityType": "chat_room",
      "payloadFields": {
        "roomId": "uuid",
        "closedAt": "ISO-8601 datetime",
        "retentionDeleteAfter": "ISO-8601 datetime"
      }
    },
    {
      "type": "driver.status_changed",
      "rooms": ["driver:{driverProfileId}", "admin:operations"],
      "entityType": "driver_profile",
      "payloadFields": {
        "driverProfileId": "uuid",
        "activationStatus": "DriverActivationStatus",
        "riskStatus": "DriverRiskStatus",
        "reasonCode": "string",
        "canReceiveJobs": "boolean"
      }
    },
    {
      "type": "account.status_changed",
      "rooms": ["account:{accountId}"],
      "entityType": "account",
      "payloadFields": {
        "accountId": "uuid",
        "status": "AccountStatus",
        "reasonCode": "string",
        "allowedActionsChanged": "boolean"
      }
    },
    {
      "type": "complaint.created",
      "rooms": ["account:{submitterAccountId}", "admin:complaints"],
      "entityType": "complaint",
      "payloadFields": {
        "complaintId": "uuid",
        "category": "ComplaintCategory",
        "severity": "ComplaintSeverity",
        "serviceType": "RIDE|FOOD|null",
        "entityId": "uuid|null",
        "requiresAdminReview": "boolean"
      }
    },
    {
      "type": "complaint.status_changed",
      "rooms": ["account:{submitterAccountId}", "account:{againstAccountId}", "admin:complaints"],
      "entityType": "complaint",
      "payloadFields": {
        "complaintId": "uuid",
        "fromStatus": "ComplaintStatus",
        "toStatus": "ComplaintStatus",
        "assignedAdminId": "uuid|null"
      }
    },
    {
      "type": "driver.auto_locked",
      "rooms": ["driver:{driverProfileId}", "admin:complaints", "admin:operations"],
      "entityType": "driver_profile",
      "payloadFields": {
        "driverProfileId": "uuid",
        "reasonCode": "TWO_QUALIFYING_OPEN_COMPLAINTS",
        "complaintIds": "uuid[]",
        "lockedAt": "ISO-8601 datetime"
      }
    },
    {
      "type": "admin.ride_changed",
      "rooms": ["admin:operations"],
      "entityType": "ride",
      "payloadFields": {
        "entityType": "ride",
        "entityId": "uuid",
        "changeType": "status_changed|payment_changed|complaint_created",
        "status": "RideStatus",
        "regionId": "uuid",
        "occurredAt": "ISO-8601 datetime"
      }
    },
    {
      "type": "admin.food_order_changed",
      "rooms": ["admin:operations"],
      "entityType": "food_order",
      "payloadFields": {
        "entityType": "food_order",
        "entityId": "uuid",
        "changeType": "status_changed|payment_changed|complaint_created",
        "status": "FoodOrderStatus",
        "regionId": "uuid",
        "occurredAt": "ISO-8601 datetime"
      }
    },
    {
      "type": "admin.complaint_queue_changed",
      "rooms": ["admin:complaints"],
      "entityType": "complaint",
      "payloadFields": {
        "entityType": "complaint",
        "entityId": "uuid",
        "changeType": "created|status_changed|assigned",
        "status": "ComplaintStatus",
        "occurredAt": "ISO-8601 datetime"
      }
    },
    {
      "type": "admin.catalog_published",
      "rooms": ["admin:operations"],
      "entityType": "catalog",
      "payloadFields": {
        "entityType": "brand|outlet|menu|menu_version",
        "entityId": "uuid",
        "status": "published|unpublished",
        "occurredAt": "ISO-8601 datetime"
      }
    }
  ],
  "p0MustHaveTests": [
    "Customer cannot subscribe to unrelated ride/order/chat room",
    "Driver cannot subscribe to another driver's offer room",
    "Admin without RBAC cannot subscribe to admin rooms",
    "Driver receives matching.offer_sent and accepts through GraphQL",
    "Expired offer emits matching.offer_expired",
    "Food assignment emits food_order.payment_required",
    "Customer payment proof emits payment.proof_submitted to driver",
    "Driver auto-lock emits driver.status_changed and driver.auto_locked",
    "Chat image emits chat.message_created to both participants",
    "Reconnect with stale sequence returns room.resync_required"
  ]
}

